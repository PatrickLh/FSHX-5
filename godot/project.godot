; Static diagnostic project. Open with Godot 4.x. Engine validation pending.
config_version=5
[application]
config/name="FSHX5 Resource Diagnostics"
run/main_scene="res://scenes/static_sample.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
[display]
window/size/viewport_width=1200
window/size/viewport_height=800
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
